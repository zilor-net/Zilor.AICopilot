# Container image name for aicopilot-httpapi
AICOPILOT_HTTPAPI_IMAGE=zilor/aicopilot-httpapi:latest

# Default container port for aicopilot-httpapi
AICOPILOT_HTTPAPI_PORT=8080

# Container image name for aicopilot-migration
AICOPILOT_MIGRATION_IMAGE=zilor/aicopilot-migration:latest

# Container image name for aicopilot-webui
AICOPILOT_WEBUI_IMAGE=zilor/aicopilot-webui:latest

# Parameter eventbus-password
EVENTBUS_PASSWORD=123456

# Parameter pg-password
PG_PASSWORD=123456

# Bind mount source for postgres:/docker-entrypoint-initdb.d
POSTGRES_BINDMOUNT_0=./sql

# Parameter qdrant-Key
QDRANT_KEY=123456

# Container image name for rag-worker
RAG_WORKER_IMAGE=zilor/aicopilot-ragworker:latest

