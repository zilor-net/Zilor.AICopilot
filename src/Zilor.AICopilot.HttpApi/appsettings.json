{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Issuer": "https://localhost",
    "Audience": "https://localhost",
    "SecretKey": "replace-with-a-secure-secret-key-from-user-secrets-or-environment",
    "AccessTokenExpirationMinutes": 525600
  }
}
